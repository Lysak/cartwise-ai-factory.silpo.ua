COMPOSE_PROJECT_NAME=cartwise

FORWARD_APP_PORT=11200
FORWARD_API_PORT=11201
FORWARD_DB_PORT=11102
FORWARD_REDIS_PORT=11103

POSTGRES_DB=cartwise
POSTGRES_USER=cartwise
POSTGRES_PASSWORD=change-me
# Generate locally: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=replace-with-a-local-32-byte-base64-key
APP_ORIGIN=https://app.example.com
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_BOT_USERNAME=@replace-with-bot-username
# Telegram restricts secret_token to A-Z a-z 0-9 _ - (no base64 padding/+//).
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TELEGRAM_WEBHOOK_SECRET=replace-with-a-local-webhook-secret
SESSION_COOKIE_INSECURE=false
TRUST_PROXY=loopback
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-rotated-cloudflare-tunnel-token
